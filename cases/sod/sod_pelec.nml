&simulation
  nx = 400
  max_steps = 100000
  x_min = 0.0
  x_max = 1.0
  final_time = 0.2
  cfl = 0.45
  gamma = 1.4
  output_file = "sod_pelec.csv"
  problem = "sod"
  reconstruction = "plm"
  limiter = "mc"
  boundary_condition = "outflow"
  riemann_solver = "pelec"
/

&sod_problem
  discontinuity = 0.5
  rho_left = 1.0
  velocity_left = 0.0
  pressure_left = 1.0
  rho_right = 0.125
  velocity_right = 0.0
  pressure_right = 0.1
/
