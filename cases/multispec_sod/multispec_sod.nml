&simulation
  nx = 400
  max_steps = 100000
  nspecies = 2
  x_min = 0.0
  x_max = 1.0
  final_time = 0.2
  cfl = 0.30
  gamma = 1.4
  output_file = "multispec_sod.csv"
  problem_name = "multispec_sod"
  reconstruction = "pelec_plm"
  limiter = "mc"
  boundary_condition = "outflow"
  riemann_solver = "pelec"
  plm_order = 2
  use_flattening = .false.
/

&multispec_sod_problem
  discontinuity = 0.5
  rho_left = 1.0
  velocity_left = 0.0
  pressure_left = 1.0
  rho_right = 0.125
  velocity_right = 0.0
  pressure_right = 0.1
  mass_fractions_left = 1.0, 0.0
  mass_fractions_right = 0.0, 1.0
/
