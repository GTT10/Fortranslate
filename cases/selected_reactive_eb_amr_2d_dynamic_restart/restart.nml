&reactive_2d
  nx = 12
  ny = 12
  maximum_steps = 20
  x_lower = 0.0
  x_upper = 0.01
  y_lower = 0.0
  y_upper = 0.01
  final_time = 1.0e-8
  cfl = 0.01
  problem = "reactive_hotspot"
  reconstruction = "characteristic_plm"
  riemann_solver = "hllc"
  limiter = "mc"
  use_transverse_correction = .false.
  chemistry_enabled = .false.
  chemistry_model = "selected"
  transport_enabled = .false.
  boundary_x_lower = "outflow"
  boundary_x_upper = "outflow"
  boundary_y_lower = "outflow"
  boundary_y_upper = "outflow"
  initial_temperature = 1000.0
  initial_pressure = 101325.0
  initial_velocity_x = 0.0
  initial_velocity_y = 0.0
  hotspot_temperature_rise = 350.0
  hotspot_center_x = 0.0072
  hotspot_center_y = 0.0062
  hotspot_width = 0.0008
  composition_count = 10
  composition_species = "N2", "H2O2", "H2", "AR", "O2", "H", "O",
    "OH", "H2O", "HO2"
  composition_mole_fractions = 0.55643, 0.0, 0.29570, 0.0, 0.14784,
    1.0e-5, 1.0e-5, 1.0e-5, 0.0, 0.0
  output_file = "selected_reactive_eb_amr_dynamic_restarted_coarse.csv"
/

&embedded_boundary
  geometry = "plane"
  plane_normal_x = 1.0
  plane_normal_y = 1.0
  plane_offset = 0.003
  state_redist_target_volume_fraction = 0.5
  state_redist_max_order = 2
  embedded_wall_kind = "slip_wall"
  embedded_wall_thermal = "adiabatic"
  embedded_wall_temperature = 1300.0
  embedded_wall_velocity = 0.0, 0.0, 0.0
/

&eb_amr
  coarse_i_lower = 2
  coarse_i_upper = 5
  coarse_j_lower = 2
  coarse_j_upper = 5
  refinement_ratio = 2
  prolongation_method = "linear"
  dynamic_regridding = .true.
  regrid_at_initialization = .false.
  regrid_interval = 1
  regrid_relative_temperature_gradient = 0.02
  regrid_absolute_temperature_gradient = 5.0
  regrid_temperature_scale_floor = 1.0
  regrid_buffer_cells = 1
  regrid_minimum_patch_cells_x = 4
  regrid_minimum_patch_cells_y = 4
  restart_file = "selected_reactive_eb_amr_dynamic_restart.chk"
  fine_output_file = "selected_reactive_eb_amr_dynamic_restarted_fine.csv"
/
