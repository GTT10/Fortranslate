&reactive_2d
  nx = 8
  ny = 8
  maximum_steps = 10
  x_lower = 0.0
  x_upper = 0.008
  y_lower = 0.0
  y_upper = 0.008
  final_time = 1.0e-12
  cfl = 8.0e-7
  problem = "reactive_hotspot"
  reconstruction = "pcm"
  riemann_solver = "hllc"
  limiter = "mc"
  use_transverse_correction = .false.
  chemistry_enabled = .true.
  chemistry_model = "selected"
  chemistry_relative_tolerance = 2.0e-7
  chemistry_absolute_tolerance = 1.0e-12
  transport_enabled = .false.
  boundary_x_lower = "outflow"
  boundary_x_upper = "outflow"
  boundary_y_lower = "outflow"
  boundary_y_upper = "outflow"
  initial_temperature = 1000.0
  initial_pressure = 101325.0
  initial_velocity_x = 0.0
  initial_velocity_y = 0.0
  hotspot_temperature_rise = 300.0
  hotspot_center_x = 0.004
  hotspot_center_y = 0.004
  hotspot_width = 0.0006
  composition_count = 10
  composition_species = "N2", "H2O2", "H2", "AR", "O2", "H", "O",
    "OH", "H2O", "HO2"
  composition_mole_fractions = 0.55643, 0.0, 0.29570, 0.0, 0.14784,
    1.0e-5, 1.0e-5, 1.0e-5, 0.0, 0.0
  output_file = "selected_mpi_eb_restart_stopped.csv"
/

&embedded_boundary
  geometry = "plane"
  plane_normal_x = 1.0
  plane_normal_y = 0.0
  plane_offset = 0.00291
  state_redist_target_volume_fraction = 0.5
  state_redist_max_order = 2
/

&eb_amr
  refinement_ratio = 2
  prolongation_method = "linear"
  patch_tree_maximum_levels = 4
  patch_tree_mpi_work_exponent = 0
  three_level_enabled = .false.
  multipatch_enabled = .false.
  dynamic_regridding = .true.
  regrid_at_initialization = .true.
  remove_fine_patch_when_untagged = .true.
  regrid_interval = 1
  regrid_relative_temperature_gradient = 1.0e-4
  regrid_absolute_temperature_gradient = 0.1
  regrid_temperature_scale_floor = 1.0
  regrid_buffer_cells = 0
  regrid_minimum_patch_cells_x = 4
  regrid_minimum_patch_cells_y = 4
  regrid_maximum_patch_gap_cells = 0
  checkpoint_interval = 1
  checkpoint_stop_after_write = .true.
  checkpoint_file = "selected_mpi_eb_restart.chk"
/
