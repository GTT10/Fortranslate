&reactive_3d
  nx = 4
  ny = 4
  nz = 4
  maximum_steps = 1000
  x_lower = 0.0
  x_upper = 0.004
  y_lower = 0.0
  y_upper = 0.004
  z_lower = 0.0
  z_upper = 0.004
  final_time = 1.0e-7
  cfl = 0.25
  problem = "uniform_reactor"
  reconstruction = "pcm"
  limiter = "mc"
  thermo_model = "selected"
  riemann_solver = "hllc"
  boundary_condition = "periodic"
  chemistry_enabled = .true.
  chemistry_relative_tolerance = 2.0e-6
  chemistry_absolute_tolerance = 1.0e-12
  transport_enabled = .false.
  initial_temperature = 1000.0
  initial_pressure = 101325.0
  initial_velocity_x = 0.0
  initial_velocity_y = 0.0
  initial_velocity_z = 0.0
  composition_count = 2
  composition_species = "H", "H2"
  composition_mole_fractions = 0.2, 0.8
  output_file = "unused_selected_fixture_regular_3d.csv"
/
&amr_reactive_3d
  refinement_ratio = 2
  coarse_i_lower = 2
  coarse_i_upper = 3
  coarse_j_lower = 2
  coarse_j_upper = 3
  coarse_k_lower = 2
  coarse_k_upper = 3
  coarse_output_file = "selected_fixture_amr_reactive_3d_coarse.csv"
  fine_output_file = "selected_fixture_amr_reactive_3d_fine.csv"
/
