# In-range 3D adaptation of pinned Spray-Evaporation. All inputs use CGS.
max_step = 2
stop_time = 2e-7
geometry.is_periodic = 1 1 1
geometry.coord_sys = 0
geometry.prob_lo = 0 0 0
geometry.prob_hi = .4 .4 .4
amr.n_cell = 4 4 4
amr.max_level = 0
amr.blocking_factor = 4
amr.max_grid_size = 4
amr.checkpoint_files_output = 0
amr.plot_file = plt
amr.plot_int = 1
amr.plot_vars = density xmom ymom zmom rho_E Temp rho_NC7H16 rho_O2 rho_N2
amr.derive_plot_vars = pressure
pelec.lo_bc = Interior Interior Interior
pelec.hi_bc = Interior Interior Interior
pelec.do_hydro = 1
pelec.do_mol = 0
pelec.do_react = 0
pelec.diffuse_vel = 1
pelec.diffuse_temp = 1
pelec.diffuse_enth = 1
pelec.diffuse_spec = 1
pelec.ppm_type = 0
pelec.plm_iorder = 4
pelec.sdc_iters = 2
pelec.fixed_dt = 1e-7
pelec.init_shrink = 1
pelec.sum_interval = 1
pelec.do_spray_particles = 1
particles.derive_plot_vars = 1
particles.fixed_parts = 0
particles.mom_transfer = 1
particles.mass_transfer = 1
particles.init_file = particles.dat
particles.write_ascii_files = 1
particles.fuel_ref_temp = 300
particles.fuel_species = NC7H16
particles.NC7H16_crit_temp = 540
particles.NC7H16_boil_temp = 371.6
particles.NC7H16_ref_temp = 300
particles.NC7H16_latent = 3.63e9
particles.NC7H16_cp = 2.2483e7
particles.NC7H16_rho = .6814
particles.NC7H16_psat = 4.02832 1268.636 -56.199 1e6
particles.use_splash_model = false
prob.init_T = 400
prob.init_p = 1.01325e6
prob.init_v = 0
prob.init_O2 = @O2@
prob.init_N2 = @N2@
