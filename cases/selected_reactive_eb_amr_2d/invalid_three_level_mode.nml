&reactive_2d
  nx = 8
  ny = 8
  final_time = 1.0e-8
  problem = "uniform_reactor"
  use_transverse_correction = .false.
  chemistry_model = "selected"
  boundary_x_lower = "outflow"
  boundary_x_upper = "outflow"
  boundary_y_lower = "outflow"
  boundary_y_upper = "outflow"
  composition_count = 2
  composition_species = "H", "H2"
  composition_mole_fractions = 0.2, 0.8
  output_file = "invalid_selected_reactive_eb_amr_three_level.csv"
/

&embedded_boundary
  geometry = "plane"
  plane_normal_x = 1.0
  plane_offset = 0.00337
/

&eb_amr
  coarse_i_lower = 2
  coarse_i_upper = 7
  coarse_j_lower = 2
  coarse_j_upper = 7
  refinement_ratio = 2
  three_level_enabled = .true.
  dynamic_regridding = .true.
  remove_fine_patch_when_untagged = .true.
  fine_output_file = "invalid_selected_reactive_eb_amr_three_level_fine.csv"
  level_two_output_file = "invalid_selected_reactive_eb_amr_three_level_finest.csv"
/
