&reactive_3d
  nx = 8
  ny = 8
  nz = 8
  maximum_steps = 100000
  x_lower = 0.0
  x_upper = 0.004
  y_lower = 0.0
  y_upper = 0.004
  z_lower = 0.0
  z_upper = 0.004
  final_time = 1.0e-9
  cfl = 0.25
  problem = "reactive_hotspot"
  reconstruction = "characteristic_plm"
  limiter = "mc"
  thermo_model = "full_h2o2"
  riemann_solver = "hllc"
  boundary_condition = "periodic"
  chemistry_enabled = .true.
  chemistry_relative_tolerance = 2.0e-7
  chemistry_absolute_tolerance = 1.0e-12
  transport_enabled = .false.
  initial_temperature = 1200.0
  initial_pressure = 101325.0
  initial_velocity_x = 0.0
  initial_velocity_y = 0.0
  initial_velocity_z = 0.0
  hotspot_temperature_rise = 250.0
  hotspot_center_x = 0.002
  hotspot_center_y = 0.002
  hotspot_center_z = 0.002
  hotspot_width = 0.0006
  x_h2 = 0.29570
  x_h = 1.0e-5
  x_o = 1.0e-5
  x_o2 = 0.14784
  x_oh = 1.0e-5
  x_h2o = 0.0
  x_ho2 = 0.0
  x_h2o2 = 0.0
  x_ar = 0.0
  x_n2 = 0.55643
  output_file = "unused_regular_3d.csv"
/
&amr_reactive_3d
  refinement_ratio = 2
  coarse_i_lower = 3
  coarse_i_upper = 6
  coarse_j_lower = 3
  coarse_j_upper = 6
  coarse_k_lower = 3
  coarse_k_upper = 6
  coarse_output_file = "amr_hotspot_chemistry_3d_coarse.csv"
  fine_output_file = "amr_hotspot_chemistry_3d_fine.csv"
/
