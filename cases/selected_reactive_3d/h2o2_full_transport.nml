&reactive_3d
  nx = 6
  ny = 6
  nz = 6
  maximum_steps = 100000
  x_lower = 0.0
  x_upper = 0.01
  y_lower = 0.0
  y_upper = 0.01
  z_lower = 0.0
  z_upper = 0.01
  final_time = 2.0e-6
  cfl = 0.30
  problem = "reactive_hotspot"
  reconstruction = "pcm"
  limiter = "mc"
  thermo_model = "selected"
  riemann_solver = "hllc"
  boundary_condition = "periodic"
  chemistry_enabled = .false.
  transport_enabled = .true.
  viscosity_enabled = .true.
  thermal_conduction_enabled = .true.
  species_diffusion_enabled = .true.
  barodiffusion_enabled = .true.
  transport_cfl = 0.35
  initial_temperature = 1000.0
  initial_pressure = 101325.0
  initial_velocity_x = 0.0
  initial_velocity_y = 0.0
  initial_velocity_z = 0.0
  hotspot_temperature_rise = 250.0
  hotspot_center_x = 0.005
  hotspot_center_y = 0.005
  hotspot_center_z = 0.005
  hotspot_width = 0.0012
  composition_count = 10
  composition_species = "N2", "H2O2", "H2", "AR", "O2", "H", "O",
    "OH", "H2O", "HO2"
  composition_mole_fractions = 0.55643, 0.0, 0.29570, 0.0, 0.14784,
    1.0e-5, 1.0e-5, 1.0e-5, 0.0, 0.0
  output_file = "selected_reactive_transport_3d.csv"
/
