&reactive_2d
  nx = 8
  ny = 8
  maximum_steps = 1000
  x_lower = 0.0
  x_upper = 0.004
  y_lower = 0.0
  y_upper = 0.004
  final_time = 2.0e-8
  cfl = 0.15
  problem = "reactive_hotspot"
  reconstruction = "characteristic_plm"
  riemann_solver = "hllc"
  limiter = "mc"
  use_transverse_correction = .false.
  chemistry_enabled = .false.
  chemistry_model = "full_h2o2"
  transport_enabled = .true.
  viscosity_enabled = .true.
  thermal_conduction_enabled = .true.
  species_diffusion_enabled = .true.
  barodiffusion_enabled = .true.
  transport_cfl = 0.30
  boundary_x_lower = "outflow"
  boundary_x_upper = "outflow"
  boundary_y_lower = "outflow"
  boundary_y_upper = "outflow"
  initial_temperature = 1000.0
  initial_pressure = 101325.0
  initial_velocity_x = 0.0
  initial_velocity_y = 0.0
  hotspot_temperature_rise = 200.0
  hotspot_center_x = 0.002
  hotspot_center_y = 0.002
  hotspot_width = 0.0007
  x_h2 = 0.29570
  x_h = 1.0e-5
  x_o = 1.0e-5
  x_o2 = 0.14784
  x_oh = 1.0e-5
  x_h2o = 0.0
  x_ho2 = 0.0
  x_h2o2 = 0.0
  x_ar = 0.0
  x_n2 = 0.55643
  output_file = "full_h2o2_reactive_eb_2d_transport.csv"
/

&embedded_boundary
  geometry = "circle"
  circle_center_x = 0.002
  circle_center_y = 0.002
  circle_radius = 0.00073
  circle_fluid_inside = .false.
  state_redist_target_volume_fraction = 0.5
  state_redist_max_order = 2
  embedded_wall_kind = "no_slip_wall"
  embedded_wall_thermal = "isothermal"
  embedded_wall_temperature = 1400.0
  embedded_wall_velocity = 0.0, 2.0, 0.0
/
