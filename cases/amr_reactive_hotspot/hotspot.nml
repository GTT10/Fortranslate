  amr_enabled = .true.
  amr_reconstruction = "plm"
  amr_refinement_ratio = 2
  amr_regrid_interval = 2
  amr_tag_component = 1
  amr_buffer_cells = 2
  amr_minimum_patch_cells = 8
  amr_relative_gradient_threshold = 0.005
