&eb_tree
 time_integrator="sdc",sdc_iterations=2,external_forcing=20000,-30000,40000,
 hydro_method="plm_ctu",boundary_faces=6*"outflow",
 regular_density=.31,cut_density=.35,initial_pressure=300000,
 root_shape=4,4,4, child_count=4,
 parent=1,1,2,3, ratio=2,2,2,2,
 lower(:,1)=1,1,2, upper(:,1)=2,2,3,
 lower(:,2)=3,1,2, upper(:,2)=4,2,3,
 lower(:,3)=3,3,2, upper(:,3)=4,4,3,
 lower(:,4)=1,3,2, upper(:,4)=2,4,3,
 geometry_type='plane', plane_axis='z', plane_position=0.31,
 time_step=1.e-10, final_time=2.e-10, maximum_steps=20,
 chemistry_enabled=.true., transport_enabled=.true.,
 chemistry_integrator='explicit', riemann_solver='pelec',
 output_file='eb_tree_sdc.csv'
/
