&reactive_2d
  nx = 14
  ny = 14
  maximum_steps = 5
  x_lower = 0.0
  x_upper = 1.0
  y_lower = 0.0
  y_upper = 1.0
  final_time = 1.0e-8
  cfl = 0.02
  problem = "reactive_double_hotspot"
  reconstruction = "pcm"
  riemann_solver = "hllc"
  limiter = "mc"
  use_transverse_correction = .false.
  chemistry_enabled = .false.
  chemistry_model = "elementary"
  transport_enabled = .false.
  boundary_x_lower = "outflow"
  boundary_x_upper = "outflow"
  boundary_y_lower = "outflow"
  boundary_y_upper = "outflow"
  initial_temperature = 1200.0
  initial_pressure = 135000.0
  initial_velocity_x = 0.0
  initial_velocity_y = 0.0
  hotspot_temperature_rise = 20.0
  hotspot_center_x = 0.03
  hotspot_center_y = 0.35
  hotspot_width = 0.03
  second_hotspot_temperature_rise = 18.0
  second_hotspot_center_x = 0.75
  second_hotspot_center_y = 0.75
  x_h2 = 0.29570
  x_h = 1.0e-5
  x_o = 1.0e-5
  x_o2 = 0.14784
  x_oh = 1.0e-5
  x_h2o = 0.0
  x_n2 = 0.55643
  output_file = "reactive_eb_amr_dynamic_boundary_coarse_2d.csv"
/

&embedded_boundary
  geometry = "plane"
  plane_normal_x = 1.0
  plane_normal_y = 1.0
  plane_offset = 0.30
  state_redist_target_volume_fraction = 0.5
  state_redist_max_order = 0
/

&eb_amr
  coarse_i_lower = 2
  coarse_i_upper = 6
  coarse_j_lower = 2
  coarse_j_upper = 6
  refinement_ratio = 2
  multipatch_enabled = .true.
  dynamic_regridding = .true.
  regrid_at_initialization = .true.
  remove_fine_patch_when_untagged = .true.
  regrid_interval = 1
  regrid_relative_temperature_gradient = 1.0e-4
  regrid_absolute_temperature_gradient = 5.0
  regrid_temperature_scale_floor = 1.0
  regrid_buffer_cells = 0
  regrid_minimum_patch_cells_x = 5
  regrid_minimum_patch_cells_y = 5
  regrid_maximum_patch_gap_cells = 0
  fine_output_file = "reactive_eb_amr_dynamic_boundary_fine_2d.csv"
/
