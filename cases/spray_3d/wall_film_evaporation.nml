! Stationary wall-film heating/evaporation; illustrative constant conductivity.
&spray
 cells=2,2,2,hydro_reconstruction='pcm',domain_length=.004,.004,.004,
 boundary_faces='periodic','periodic','periodic','periodic','no_slip_wall','no_slip_wall',
 wall_impact_faces=.false.,.false.,.false.,.false.,.true.,.false.,
 wall_film_evolution=.true.,wall_liquid_conductivity=.6,minimum_film_height=1e-7,
 wall_temperature=340,340,340,340,340,340,
 surface_tension=.072,liquid_viscosity=.001,
 gas_temperature=900,gas_pressure=101325,mole_names='N2','','',mole_amounts=1,0,0,
 chemistry_enabled=.false.,transport_enabled=.false.,drag_enabled=.false.,
 injection_center=.002,.002,5e-7,injection_axis=0,0,-1,injection_speed=10,cone_angle=0,
 initial_liquid_mass=1e-10,parcel_count=1,drop_temperature=330,drop_diameter=20e-6,
 final_time=1e-6,maximum_dt=1e-7,
 output_prefix='film_evaporation',checkpoint_file='film_evaporation.chk'
/
