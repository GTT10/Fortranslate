&reactive_1d
  nx = 16
  maximum_steps = 2000
  x_lower = 0.0
  x_upper = 0.008
  final_time = 1.0e-9
  cfl = 0.20
  problem = "reactive_hotspot"
  reconstruction = "pcm"
  riemann_solver = "hllc"
  limiter = "mc"
  boundary_condition = "periodic"
  chemistry_enabled = .true.
  chemistry_model = "selected"
  transport_enabled = .true.
  transport_cfl = 0.30
  chemistry_relative_tolerance = 2.0e-7
  chemistry_absolute_tolerance = 1.0e-12
  initial_temperature = 1200.0
  initial_pressure = 101325.0
  initial_velocity = 0.0
  hotspot_temperature_rise = 100.0
  hotspot_center = 0.004
  hotspot_width = 0.001
  composition_count = 10
  composition_species = "N2", "H2O2", "H2", "AR", "O2", "H", "O",
    "OH", "H2O", "HO2"
  composition_mole_fractions = 0.55643, 0.0, 0.29570, 0.0, 0.14784,
    1.0e-5, 1.0e-5, 1.0e-5, 0.0, 0.0
  amr_enabled = .true.
  amr_reconstruction = "plm"
  amr_refinement_ratio = 2
  amr_regrid_interval = 1
  amr_tag_component = 1
  amr_buffer_cells = 1
  amr_minimum_patch_cells = 4
  amr_relative_gradient_threshold = 0.004
  amr_absolute_gradient_threshold = 0.0
  amr_scale_floor = 1.0e-12
  output_file = "selected_full_h2o2_amr_two_level.csv"
/
