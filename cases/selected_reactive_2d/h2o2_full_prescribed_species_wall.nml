  species_diffusion_enabled = .true.
  barodiffusion_enabled = .false.
  transport_cfl = 0.35
  boundary_x_lower = "periodic"
  boundary_x_upper = "periodic"
  boundary_y_lower = "slip_wall"
  boundary_y_upper = "slip_wall"
  wall_species_y_lower = "prescribed"
