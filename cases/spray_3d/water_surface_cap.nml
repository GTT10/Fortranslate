! Surface vapor-state cap at 0.99 of the pressure-dependent boiling temperature.
! Constant-property demonstration, not a physical boiling experiment.
&spray
 cells=4,4,4, domain_length=.004,.004,.004,
 gas_temperature=900, gas_pressure=101325,
 mole_names='N2','','', mole_amounts=1,0,0,
 chemistry_enabled=.false.,
 boiling_model='surface-cap',critical_temperature=647,
 vapor_name='H2O', liquid_density=1000, liquid_cp=4184,
 reference_temperature=373.15, reference_pressure=101325, latent_heat=2257000,
 drop_temperature=400, drop_diameter=20e-6,
 initial_liquid_mass=1e-10, parcel_count=4,
 injection_center=.0015,.0015,.0015, injection_axis=0,0,1,
 injection_speed=10, cone_angle=.1,
 final_time=2e-6, maximum_dt=1e-7,
 output_prefix='water_surface_cap', checkpoint_file='water_surface_cap.chk'
/
