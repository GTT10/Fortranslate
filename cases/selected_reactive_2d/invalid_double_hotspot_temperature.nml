&reactive_2d
  nx = 4
  ny = 4
  final_time = 1.0e-9
  problem = "reactive_double_hotspot"
  reconstruction = "pcm"
  use_transverse_correction = .false.
  chemistry_enabled = .false.
  chemistry_model = "selected"
  transport_enabled = .false.
  initial_temperature = 3000.0
  initial_pressure = 101325.0
  initial_velocity_x = 0.0
  initial_velocity_y = 0.0
  hotspot_temperature_rise = 400.0
  second_hotspot_temperature_rise = 400.0
  hotspot_center_x = 0.002
  hotspot_center_y = 0.002
  second_hotspot_center_x = 0.002
  second_hotspot_center_y = 0.002
  hotspot_width = 0.0006
  composition_count = 2
  composition_species = "H2", "H"
  composition_mole_fractions = 0.8, 0.2
  output_file = "invalid_double_hotspot_temperature_2d.csv"
/
