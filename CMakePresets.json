{
  "version": 6,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PELEF_ENABLE_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PELEF_ENABLE_TESTS": "ON"
      }
    },
    {
      "name": "debug-cantera",
      "displayName": "Debug with live Cantera parity",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/debug-cantera",
      "cacheVariables": {
        "PELEF_ENABLE_CANTERA_REFERENCE": "ON"
      }
    },
    {
      "name": "mpi-debug",
      "displayName": "MPI Debug",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/mpi-debug",
      "cacheVariables": {
        "PELEF_ENABLE_MPI": "ON"
      }
    },
    {
      "name": "mpi-release",
      "displayName": "MPI Release",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/mpi-release",
      "cacheVariables": {
        "PELEF_ENABLE_MPI": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "debug-cantera",
      "configurePreset": "debug-cantera"
    },
    {
      "name": "mpi-debug",
      "configurePreset": "mpi-debug"
    },
    {
      "name": "mpi-release",
      "configurePreset": "mpi-release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-cantera",
      "configurePreset": "debug-cantera",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "mpi-debug",
      "configurePreset": "mpi-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "mpi-release",
      "configurePreset": "mpi-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
