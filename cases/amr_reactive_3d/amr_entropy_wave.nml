&reactive_3d
  nx = 8
  ny = 8
  nz = 8
  maximum_steps = 100000
  x_lower = 0.0
  x_upper = 0.01
  y_lower = 0.0
  y_upper = 0.01
  z_lower = 0.0
  z_upper = 0.01
  final_time = 1.0e-6
  cfl = 0.30
  problem = "entropy_wave"
  thermo_model = "full_h2o2"
  riemann_solver = "pelec"
  boundary_condition = "periodic"
  chemistry_enabled = .false.
  transport_enabled = .false.
  initial_temperature = 1000.0
  initial_pressure = 101325.0
  initial_velocity_x = 240.0
  initial_velocity_y = -90.0
  initial_velocity_z = 60.0
  density_wave_amplitude = 0.08
  wave_number_x = 1
  wave_number_y = 2
  wave_number_z = 1
  x_h2 = 0.29570
  x_h = 1.0e-5
  x_o = 1.0e-5
  x_o2 = 0.14784
  x_oh = 1.0e-5
  x_h2o = 0.0
  x_ho2 = 0.0
  x_h2o2 = 0.0
  x_ar = 0.0
  x_n2 = 0.55643
  output_file = "unused_regular_3d.csv"
/
&amr_reactive_3d
  refinement_ratio = 2
  coarse_i_lower = 3
  coarse_i_upper = 6
  coarse_j_lower = 3
  coarse_j_upper = 6
  coarse_k_lower = 3
  coarse_k_upper = 6
  coarse_output_file = "amr_reactive_3d_coarse.csv"
  fine_output_file = "amr_reactive_3d_fine.csv"
/
