# Pinned, unmodified EB-C3 problem with LiDryer. PeleC uses CGS units.
max_step = 3
stop_time = 3.e-7
geometry.is_periodic = 0 0 0
geometry.coord_sys = 0
geometry.prob_lo = 0 0 0
geometry.prob_hi = 1 1 1
amr.n_cell = 8 8 8
amr.max_level = 0
amr.blocking_factor = 8
amr.max_grid_size = 8
amr.checkpoint_files_output = 0
amr.plot_files_output = 1
amr.plot_file = plt
amr.plot_int = 1
amr.derive_plot_vars = density xmom ymom zmom rho_E rho_e Temp rho_H2 rho_O2 rho_H2O rho_H rho_O rho_OH rho_HO2 rho_H2O2 rho_N2 vfrac
pelec.lo_bc = "FOExtrap" "FOExtrap" "FOExtrap"
pelec.hi_bc = "FOExtrap" "FOExtrap" "FOExtrap"
pelec.do_hydro = 1
pelec.do_mol = 1
pelec.mol_iters = 2
pelec.do_react = 1
pelec.chem_integrator = "ReactorCvode"
pelec.diffuse_temp = 0
pelec.diffuse_vel = 0
pelec.diffuse_spec = 0
pelec.diffuse_enth = 0
pelec.allow_negative_energy = 0
pelec.dual_energy_eta2 = 2
pelec.redistribution_type = "NoRedist"
pelec.fixed_dt = 1.e-7
pelec.init_shrink = 1
pelec.cfl = 0.2
pelec.eb_isothermal = 0
pelec.eb_zero_body_state = 1
pelec.sum_interval = 1
pelec.v = 1
amr.v = 1
eb2.geom_type = "plane"
eb2.plane_point = 0 0 0.31
eb2.plane_normal = 0 0 -1
prob.p_init = 1013250
prob.T_init = 2000
prob.Y_init_H2 = 0.06
prob.Y_init_O2 = 0.5
prob.Y_init_N2 = 0.44
ode.rtol = 1.e-10
ode.atol = 1.e-18
cvode.solve_type = "denseAJ_direct"
