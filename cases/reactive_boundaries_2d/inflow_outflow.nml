&reactive_2d
  nx = 32
  ny = 8
  x_lower = 0.0
  x_upper = 0.01
  y_lower = 0.0
  y_upper = 0.0025
  final_time = 2.0e-6
  cfl = 0.25
  maximum_steps = 20000
  problem = "inflow_outflow"
  reconstruction = "characteristic_plm"
  riemann_solver = "hllc"
  limiter = "mc"
  use_transverse_correction = .true.
  chemistry_enabled = .false.
  transport_enabled = .true.
  viscosity_enabled = .true.
  thermal_conduction_enabled = .true.
  species_diffusion_enabled = .true.
  barodiffusion_enabled = .true.
  transport_cfl = 0.35
  boundary_x_lower = "inflow"
  boundary_x_upper = "outflow"
  boundary_y_lower = "periodic"
  boundary_y_upper = "periodic"
  initial_temperature = 1000.0
  initial_pressure = 101325.0
  initial_velocity_x = 75.0
  initial_velocity_y = 0.0
  x_h2 = 0.29570
  x_h = 1.0e-5
  x_o = 1.0e-5
  x_o2 = 0.14784
  x_oh = 1.0e-5
  x_h2o = 0.0
  x_n2 = 0.55643
  output_file = "reactive_inflow_outflow_2d.csv"
/
