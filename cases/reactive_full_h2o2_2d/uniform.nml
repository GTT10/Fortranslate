&reactive_2d
  nx = 4
  ny = 4
  maximum_steps = 20000
  x_lower = 0.0
  x_upper = 0.004
  y_lower = 0.0
  y_upper = 0.004
  final_time = 2.0e-6
  cfl = 0.20
  problem = "uniform_reactor"
  reconstruction = "pcm"
  riemann_solver = "hllc"
  limiter = "mc"
  use_transverse_correction = .false.
  chemistry_enabled = .true.
  chemistry_model = "full_h2o2"
  transport_enabled = .false.
  boundary_x_lower = "periodic"
  boundary_x_upper = "periodic"
  boundary_y_lower = "periodic"
  boundary_y_upper = "periodic"
  chemistry_relative_tolerance = 2.0e-6
  chemistry_absolute_tolerance = 1.0e-12
  initial_temperature = 1000.0
  initial_pressure = 101325.0
  initial_velocity_x = 0.0
  initial_velocity_y = 0.0
  x_h2 = 0.29570
  x_h = 1.0e-5
  x_o = 1.0e-5
  x_o2 = 0.14784
  x_oh = 1.0e-5
  x_h2o = 0.0
  x_ho2 = 0.0
  x_h2o2 = 0.0
  x_ar = 0.0
  x_n2 = 0.55643
  output_file = "reactive_full_h2o2_2d.csv"
/
