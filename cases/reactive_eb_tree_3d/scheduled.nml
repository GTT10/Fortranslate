&eb_tree
 root_shape=4,4,4, child_count=4,
 parent=1,1,2,3, ratio=2,2,2,2,
 lower(:,1)=1,1,2, upper(:,1)=2,2,3,
 lower(:,2)=3,1,2, upper(:,2)=4,2,3,
 lower(:,3)=3,3,2, upper(:,3)=4,4,3,
 lower(:,4)=1,3,2, upper(:,4)=2,4,3,
 geometry_type='plane', plane_axis='z', plane_position=0.31,
 time_step=1.e-9, final_time=3.e-9, maximum_steps=20,
 chemistry_enabled=.true., transport_enabled=.true.,
 chemistry_integrator='explicit', riemann_solver='hllc',
 regrid_count=2, regrid_times=1.5e-9,2.5e-9,
 regrid_child_count=0,3,
 regrid_parent(:,2)=1,1,2, regrid_ratio(:,2)=2,2,2,
 regrid_lower(:,1,2)=1,1,2, regrid_upper(:,1,2)=2,2,3,
 regrid_lower(:,2,2)=3,1,2, regrid_upper(:,2,2)=4,2,3,
 regrid_lower(:,3,2)=2,3,2, regrid_upper(:,3,2)=3,4,3,
 output_file='eb_tree.csv' 
/
