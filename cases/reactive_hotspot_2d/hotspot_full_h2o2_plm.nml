&reactive_2d
  nx = 4
  ny = 4
  maximum_steps = 100000
  x_lower = 0.0
  x_upper = 0.004
  y_lower = 0.0
  y_upper = 0.004
  final_time = 1.0e-9
  cfl = 0.25
  problem = "reactive_hotspot"
  reconstruction = "characteristic_plm"
  riemann_solver = "hllc"
  limiter = "mc"
  use_transverse_correction = .true.
  chemistry_enabled = .true.
  chemistry_model = "full_h2o2"
  chemistry_relative_tolerance = 2.0e-7
  chemistry_absolute_tolerance = 1.0e-12
  transport_enabled = .false.
  boundary_x_lower = "periodic"
  boundary_x_upper = "periodic"
  boundary_y_lower = "periodic"
  boundary_y_upper = "periodic"
  initial_temperature = 1200.0
  initial_pressure = 101325.0
  initial_velocity_x = 0.0
  initial_velocity_y = 0.0
  hotspot_temperature_rise = 250.0
  hotspot_center_x = 0.002
  hotspot_center_y = 0.002
  hotspot_width = 0.0006
  x_h2 = 0.29570
  x_h = 1.0e-5
  x_o = 1.0e-5
  x_o2 = 0.14784
  x_oh = 1.0e-5
  x_h2o = 0.0
  x_ho2 = 0.0
  x_h2o2 = 0.0
  x_ar = 0.0
  x_n2 = 0.55643
  output_file = "full_h2o2_chemistry_plm_2d.csv"
/
