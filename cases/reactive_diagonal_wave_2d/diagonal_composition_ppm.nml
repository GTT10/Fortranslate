  maximum_steps = 20000
  problem = "diagonal_composition_wave"
  reconstruction = "characteristic_ppm"
  riemann_solver = "hllc"
  limiter = "mc"
  use_transverse_correction = .true.
  chemistry_enabled = .false.
  ppm_contact_steepening = .false.
  ppm_shock_flattening = .false.
  initial_temperature = 1000.0
  initial_pressure = 101325.0
  initial_velocity_x = 300.0
  initial_velocity_y = 200.0
  composition_wave_amplitude = 0.04
  x_h2 = 0.29570
  x_h = 1.0e-5
  x_o = 1.0e-5
  x_o2 = 0.14784
  x_oh = 1.0e-5
  x_h2o = 0.0
  x_n2 = 0.55643
  output_file = "reactive_diagonal_composition_ppm_2d.csv"
/
