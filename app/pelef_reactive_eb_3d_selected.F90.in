program pelef_reactive_eb_3d_selected
  use precision_mod, only: dp
  use nasa7_thermo_mod, only: nasa7_species
  use elementary_kinetics_mod, only: elementary_reaction
  use gas_transport_mod, only: gas_transport_species
  use mixture_thermo_mod, only: &
    mass_fractions_from_mole_fractions, mixture_specific_gas_constant
  use selected_mechanism_runtime_mod, only: &
    prepare_selected_mechanism, validate_selected_temperature_range
  use simulation_config_reactive_eb_3d_mod, only: &
    reactive_eb_3d_config, read_reactive_eb_3d_configuration, &
    resolve_reactive_eb_3d_selected_composition
  use simulation_config_selected_reactor_mod, only: &
    selected_reactor_paths_alias_lexically
  use reactive_eb_3d_driver_mod, only: &
    reactive_eb_element_species_supported_3d
  use reactive_eb_3d_application_mod, only: &
    run_reactive_eb_3d_application
  use @PELEF_BUNDLE_MODULE_NAME@, only: &
    pelef_selected_species_count => @PELEF_BUNDLE_NSPECIES_SYMBOL@, &
    pelef_selected_reaction_count => @PELEF_BUNDLE_NREACTIONS_SYMBOL@, &
    pelef_selected_chemistry_integrator => &
      @PELEF_BUNDLE_CHEMISTRY_INTEGRATOR_SYMBOL@, &
    pelef_load_selected_reactions => &
      @PELEF_BUNDLE_LOADER_NAME@, &
    pelef_load_selected_thermo => &
      @PELEF_BUNDLE_THERMO_LOADER_NAME@, &
    pelef_load_selected_transport => &
      @PELEF_BUNDLE_TRANSPORT_LOADER_NAME@
  implicit none

  character(len=*), parameter :: pelef_selected_bundle_sha256 = &
    "@PELEF_BUNDLE_BUNDLE_SHA256@"

  type(reactive_eb_3d_config) :: config
  type(nasa7_species), allocatable :: species(:)
  type(elementary_reaction), allocatable :: reactions(:)
  type(gas_transport_species), allocatable :: transport(:)
  character(len=24) :: transport_names(pelef_selected_species_count)
  integer :: transport_geometries(pelef_selected_species_count)
  real(dp) :: transport_values(5, pelef_selected_species_count)
  real(dp) :: mole_fractions(pelef_selected_species_count)
  real(dp) :: mass_fractions(pelef_selected_species_count)
  real(dp) :: common_temperature_minimum, common_temperature_maximum
  real(dp) :: requested_temperature_minimum, requested_temperature_maximum
  real(dp) :: mixture_gas_constant, regular_temperature, cut_temperature
  character(len=1024) :: input_path, message
  logical :: ok

  if (command_argument_count() /= 1) then
    write(*, '(a)') &
      "Usage: pelef_reactive_eb_3d_selected <input.nml>"
    error stop 2
  end if
  call get_command_argument(1, input_path)
  call read_reactive_eb_3d_configuration( &
    trim(input_path), config, ok, message, allow_selected=.true.)
  if (.not. ok) then
    write(*, '(a)') trim(message)
    error stop 2
  end if
  if (trim(config%thermo_model) /= "selected") then
    error stop "Selected reactive EB 3D requires thermo_model='selected'"
  end if
  if (selected_reactor_paths_alias_lexically( &
      config%output_file, input_path)) then
    error stop "Selected reactive EB 3D input and output paths must differ"
  end if
  if (config%checkpoint_interval_steps > 0 .and. &
      selected_reactor_paths_alias_lexically( &
        config%checkpoint_file, input_path)) then
    error stop &
      "Selected reactive EB 3D input and checkpoint paths must differ"
  end if
  if (len_trim(config%restart_file) > 0 .and. &
      selected_reactor_paths_alias_lexically( &
        config%restart_file, input_path)) then
    error stop "Selected reactive EB 3D input and restart paths must differ"
  end if

  call pelef_load_selected_thermo(species, ok)
  if (.not. ok .or. .not. allocated(species)) then
    error stop "Failed to load selected reactive EB 3D thermodynamics"
  end if
  call pelef_load_selected_reactions(reactions, ok)
  if (.not. ok .or. .not. allocated(reactions)) then
    error stop "Failed to load selected reactive EB 3D reactions"
  end if
  call pelef_load_selected_transport( &
    transport_names, transport_geometries, transport_values, ok)
  if (.not. ok) then
    error stop "Failed to load selected reactive EB 3D transport data"
  end if
  call prepare_selected_mechanism( &
    "Selected reactive EB 3D", pelef_selected_species_count, &
    pelef_selected_reaction_count, species, reactions, transport_names, &
    transport_geometries, transport_values, transport, &
    common_temperature_minimum, common_temperature_maximum, ok, message)
  if (.not. ok) then
    write(*, '(a)') trim(message)
    error stop 2
  end if
  if (config%chemistry_enabled .and. &
      .not. reactive_eb_element_species_supported_3d(species)) then
    error stop &
      "Selected reactive EB 3D chemistry requires supported H/O/N species"
  end if

  call resolve_reactive_eb_3d_selected_composition( &
    config, species, mole_fractions, ok, message)
  if (.not. ok) then
    write(*, '(a)') trim(message)
    error stop 2
  end if
  call mass_fractions_from_mole_fractions( &
    species, mole_fractions, mass_fractions, ok)
  if (.not. ok) then
    error stop "Failed to construct selected reactive EB 3D composition"
  end if
  mixture_gas_constant = &
    mixture_specific_gas_constant(species, mass_fractions, ok)
  if (.not. ok) then
    error stop "Failed to construct selected reactive EB 3D gas constant"
  end if
  regular_temperature = config%initial_pressure / &
    (config%regular_density * mixture_gas_constant)
  cut_temperature = config%initial_pressure / &
    (config%cut_density * mixture_gas_constant)
  requested_temperature_minimum = min(regular_temperature, cut_temperature)
  requested_temperature_maximum = max(regular_temperature, cut_temperature)
  call validate_selected_temperature_range( &
    "Selected reactive EB 3D", requested_temperature_minimum, &
    requested_temperature_maximum, common_temperature_minimum, &
    common_temperature_maximum, ok, message)
  if (.not. ok) then
    write(*, '(a)') trim(message)
    error stop 2
  end if

  write(*, '(a,i0)') "Species: ", pelef_selected_species_count
  write(*, '(a,i0)') "Reactions: ", pelef_selected_reaction_count
  call run_reactive_eb_3d_application( &
    trim(input_path), "selected mechanism reactive planar EB 3D", &
    pelef_selected_bundle_sha256, config, species, reactions, transport, &
    mole_fractions, pelef_selected_chemistry_integrator)
end program pelef_reactive_eb_3d_selected
