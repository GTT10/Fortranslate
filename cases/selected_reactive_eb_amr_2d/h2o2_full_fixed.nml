&reactive_2d
  nx = 8
  ny = 8
  maximum_steps = 2000
  x_lower = 0.0
  x_upper = 0.008
  y_lower = 0.0
  y_upper = 0.008
  final_time = 2.0e-8
  cfl = 0.15
  problem = "reactive_hotspot"
  reconstruction = "characteristic_plm"
  riemann_solver = "hllc"
  limiter = "mc"
  use_transverse_correction = .false.
  chemistry_enabled = .true.
  chemistry_model = "full_h2o2"
  chemistry_relative_tolerance = 2.0e-6
  chemistry_absolute_tolerance = 1.0e-12
  transport_enabled = .true.
  viscosity_enabled = .true.
  thermal_conduction_enabled = .true.
  species_diffusion_enabled = .true.
  barodiffusion_enabled = .true.
  transport_cfl = 0.25
  boundary_x_lower = "outflow"
  boundary_x_upper = "outflow"
  boundary_y_lower = "outflow"
  boundary_y_upper = "outflow"
  initial_temperature = 1000.0
  initial_pressure = 101325.0
  initial_velocity_x = 0.0
  initial_velocity_y = 0.0
  hotspot_temperature_rise = 200.0
  hotspot_center_x = 0.004
  hotspot_center_y = 0.004
  hotspot_width = 0.0012
  x_h2 = 0.29570
  x_h = 1.0e-5
  x_o = 1.0e-5
  x_o2 = 0.14784
  x_oh = 1.0e-5
  x_h2o = 0.0
  x_ho2 = 0.0
  x_h2o2 = 0.0
  x_ar = 0.0
  x_n2 = 0.55643
  output_file = "full_h2o2_reactive_eb_amr_2d_coarse.csv"
/

&embedded_boundary
  geometry = "plane"
  plane_normal_x = 1.0
  plane_normal_y = 0.0
  plane_offset = 0.00337
  state_redist_target_volume_fraction = 0.5
  state_redist_max_order = 2
  embedded_wall_kind = "no_slip_wall"
  embedded_wall_thermal = "isothermal"
  embedded_wall_temperature = 1300.0
  embedded_wall_velocity = 0.0, 5.0, 0.0
/

&eb_amr
  coarse_i_lower = 2
  coarse_i_upper = 7
  coarse_j_lower = 2
  coarse_j_upper = 7
  refinement_ratio = 2
  prolongation_method = "linear"
  dynamic_regridding = .false.
  fine_output_file = "full_h2o2_reactive_eb_amr_2d_fine.csv"
/
