&reactive_2d
  nx = 8
  ny = 8
  maximum_steps = 1
  x_lower = 0.0
  x_upper = 0.008
  y_lower = 0.0
  y_upper = 0.008
  final_time = 1.0e-8
  cfl = 0.1
  problem = "reactive_hotspot"
  reconstruction = "pcm"
  riemann_solver = "hllc"
  limiter = "mc"
  use_transverse_correction = .false.
  chemistry_enabled = .false.
  chemistry_model = "selected"
  transport_enabled = .false.
  boundary_x_lower = "outflow"
  boundary_x_upper = "outflow"
  boundary_y_lower = "outflow"
  boundary_y_upper = "outflow"
  initial_temperature = 1000.0
  initial_pressure = 101325.0
  composition_count = 3
  composition_species = "H2", "O2", "N2"
  composition_mole_fractions = 0.30, 0.15, 0.55
  output_file = "invalid_selected_reactive_eb_amr_checkpoint_restart_coarse.csv"
/

&embedded_boundary
  geometry = "plane"
  plane_normal_x = 1.0
  plane_normal_y = 0.0
  plane_offset = 0.00337
  embedded_wall_kind = "slip_wall"
  embedded_wall_thermal = "adiabatic"
/

&eb_amr
  coarse_i_lower = 2
  coarse_i_upper = 7
  coarse_j_lower = 2
  coarse_j_upper = 7
  refinement_ratio = 2
  checkpoint_interval = 1
  checkpoint_file = "invalid_selected_reactive_eb_amr_checkpoint_restart.chk"
  restart_file = "invalid_selected_reactive_eb_amr_checkpoint_restart.chk"
  fine_output_file = "invalid_selected_reactive_eb_amr_checkpoint_restart_fine.csv"
/
