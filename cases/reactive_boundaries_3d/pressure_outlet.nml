&reactive_3d
  nx=4, ny=4, nz=4,
  final_time=2e-7,
  problem='entropy_wave', density_wave_amplitude=0,
  reconstruction='characteristic_plm', riemann_solver='hllc',
  boundary_faces='outflow','outflow','periodic','periodic','periodic','periodic',
  outlet_pressure=0,102325,0,0,0,0,
  initial_pressure=101325, initial_temperature=1000,
  initial_velocity_x=0, initial_velocity_y=0, initial_velocity_z=0,
  chemistry_enabled=.true., transport_enabled=.true.,
  output_file='pressure_outlet.csv'
/
