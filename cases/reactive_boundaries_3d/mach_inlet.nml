&reactive_3d
  nx=4, ny=4, nz=4,
  x_upper=.004, y_upper=.004, z_upper=.004,
  final_time=2e-7,
  problem='uniform_reactor',
  reconstruction='characteristic_plm', riemann_solver='hllc',
  boundary_faces='inflow','outflow','periodic','periodic','outflow','inflow',
  inflow_mach=.2,-1,-1,-1,-1,.1,
  inflow_temperature(1)=1200, inflow_pressure(1)=0,
  inflow_temperature(6)=1100, inflow_pressure(6)=120000,
  initial_velocity_x=0, initial_velocity_y=0, initial_velocity_z=0,
  chemistry_enabled=.true., transport_enabled=.true.,
  output_file='mach_inlet.csv'
/
